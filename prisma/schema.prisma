
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(80)
  email       String    @unique @db.VarChar(100)
  password    String    @db.VarChar(50)
  birthDate   DateTime
}
